plugins {
    id 'com.android.application'
}

def envValue = { String name -> System.getenv(name)?.trim() }
def ksBase64 = envValue('WXH_KEYSTORE_BASE64')
def signingStorePassword = envValue('WXH_STORE_PASSWORD')
def signingKeyAlias = envValue('WXH_KEY_ALIAS')
def signingKeyPassword = envValue('WXH_KEY_PASSWORD')
def hasSigning = ksBase64 && signingStorePassword && signingKeyAlias && signingKeyPassword

android {
    namespace 'github.shadowbaby.wechatxposed.hook'
    compileSdk 37

    defaultConfig {
        applicationId 'github.shadowbaby.wechatxposed.hook'
        minSdk 26
        targetSdk 37
        versionCode 1
        versionName '1.0'

        ndk {
            abiFilters 'arm64-v8a', 'armeabi-v7a'
        }
    }

    signingConfigs {
        release {
            if (hasSigning) {
                def keystore = layout.buildDirectory.file('keystore/release.jks').get().asFile
                keystore.parentFile.mkdirs()
                try {
                    keystore.bytes = Base64.getDecoder().decode(ksBase64.replaceAll('\\s', ''))
                } catch (IllegalArgumentException error) {
                    throw new GradleException('WXH_KEYSTORE_BASE64 不是合法 Base64: '
                            + error.message)
                }
                storeFile keystore
                storePassword signingStorePassword
                keyAlias signingKeyAlias
                keyPassword signingKeyPassword
            }
        }
    }

    buildTypes {
        release {
            minifyEnabled true
            shrinkResources true
            proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'
            signingConfig hasSigning ? signingConfigs.release : signingConfigs.debug
        }
    }

    flavorDimensions 'framework'
    productFlavors {
        legacy { dimension 'framework' }
        modern { dimension 'framework' }
    }

    sourceSets {
        main {
            jniLibs.srcDirs = ['src/main/jniLibs']
        }
    }

    compileOptions {
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
    }
}

dependencies {
    compileOnly 'de.robv.android.xposed:api:82'
    compileOnly 'io.github.libxposed:api:102.0.0'
}
