<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
          tools:ignore="MissingVersion">
    <queries>
        <package android:name="com.tencent.mm"/>
    </queries>
    <application android:label="@string/app_name"
                 android:icon="@mipmap/logo"
                 android:description="@string/xp_desc">
        <activity
            android:name="io.github.shadowbaby.wechatxposed.hook.ui.MainActivity"
            android:exported="true"
            android:icon="@mipmap/logo"
            android:label="@string/app_name"
            android:theme="@style/Theme.X">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS"/>
            </intent-filter>
        </activity>
        <activity-alias
            android:name="io.github.shadowbaby.wechatxposed.hook.ui.MainActivityAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/logo"
            android:label="@string/app_name"
            android:targetActivity="io.github.shadowbaby.wechatxposed.hook.ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <meta-data android:name="xposedmodule" android:value="true"/>
        <meta-data android:name="xposeddescription" android:resource="@string/xp_desc"/>
        <meta-data android:name="xposedminversion" android:value="82"/>
        <meta-data android:name="xposedscope" android:value="com.tencent.mm"/>
    </application>
</manifest>
